VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public RevenueCat API key for the Android app (Project settings > API keys
# in the RevenueCat dashboard). Safe to expose client-side. Real purchases are
# a no-op without it - see TODO.md for the rest of the Premium payment setup.
VITE_REVENUECAT_ANDROID_KEY=your-revenuecat-public-android-key

# Google OAuth client id of type "Web application" (Google Cloud Console >
# APIs & Services > Credentials). Safe to expose client-side. Google sign-in
# and the cloud save stay off without it - see TODO.md for the setup steps.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
